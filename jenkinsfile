// Runs the Playwright suite with Node.js directly (no Docker), on Windows or Linux agents.
// Requires these Jenkins plugins: Pipeline, NodeJS, HTML Publisher, JUnit, Timestamper.
// The NodeJS tool name below must match Manage Jenkins -> Tools -> NodeJS installations.

// Run a command with the right shell for the agent: bat on Windows, sh elsewhere.
def runCmd(String command) {
  if (isUnix()) {
    sh command
  } else {
    bat command
  }
}

pipeline {
  agent any

  tools {
    nodejs 'NodeJS_Playwright'
  }

  triggers {
    // Every day between 7:00 and 7:59 AM Eastern (Jenkins picks a fixed minute in that hour).
    // TZ makes Jenkins follow daylight saving time, unlike GitHub's UTC-only schedule.
    // Jenkins registers this trigger after the job has run once.
    cron('TZ=America/New_York\nH 7 * * *')
  }

  options {
    timestamps()
    timeout(time: 30, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '30'))
    disableConcurrentBuilds()
  }

  environment {
    CI = 'true'
  }

  stages {
    stage('Install dependencies') {
      steps {
        script { runCmd 'npm ci' }
      }
    }

    stage('Install browsers') {
      steps {
        script { runCmd 'npx playwright install chromium firefox' }
      }
    }

    stage('Type-check') {
      steps {
        script { runCmd 'npm run typecheck' }
      }
    }

    stage('Run UI and API tests') {
      steps {
        script { runCmd 'npm test' }
      }
    }
  }

  post {
    always {
      junit testResults: 'test-results/junit.xml', allowEmptyResults: true
      publishHTML(target: [
        reportDir: 'playwright-report',
        reportFiles: 'index.html',
        reportName: 'Playwright Report',
        keepAll: true,
        alwaysLinkToLastBuild: true,
        allowMissing: true
      ])
      archiveArtifacts artifacts: 'playwright-report/**, test-results/**', allowEmptyArchive: true
    }
  }
}
